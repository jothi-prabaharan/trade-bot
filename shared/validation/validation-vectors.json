{
  "$comment": "Shared validation test vectors. Run by backend (xUnit) and frontend (Angular) test suites; both must produce exactly 'expect'. Field errors are 'field:CODE', cross-field errors are 'CODE'.",
  "bracket": [
    {
      "name": "valid long bracket",
      "entry": 100,
      "stopLoss": 85,
      "target": 130,
      "expect": []
    },
    {
      "name": "missing stop-loss",
      "entry": 100,
      "stopLoss": null,
      "target": 130,
      "expect": [
        "stopLossPrice:FX_SL_REQUIRED"
      ]
    },
    {
      "name": "missing target",
      "entry": 100,
      "stopLoss": 85,
      "target": null,
      "expect": [
        "targetSellPrice:FX_TARGET_REQUIRED"
      ]
    },
    {
      "name": "missing both",
      "entry": 100,
      "stopLoss": null,
      "target": null,
      "expect": [
        "stopLossPrice:FX_SL_REQUIRED",
        "targetSellPrice:FX_TARGET_REQUIRED"
      ]
    },
    {
      "name": "zero stop-loss",
      "entry": 100,
      "stopLoss": 0,
      "target": 130,
      "expect": [
        "stopLossPrice:FX_SL_NOT_POSITIVE"
      ]
    },
    {
      "name": "negative stop-loss",
      "entry": 100,
      "stopLoss": -5,
      "target": 130,
      "expect": [
        "stopLossPrice:FX_SL_NOT_POSITIVE"
      ]
    },
    {
      "name": "stop-loss equals entry",
      "entry": 100,
      "stopLoss": 100,
      "target": 130,
      "expect": [
        "stopLossPrice:FX_SL_NOT_BELOW_ENTRY"
      ]
    },
    {
      "name": "stop-loss above entry",
      "entry": 100,
      "stopLoss": 105,
      "target": 130,
      "expect": [
        "stopLossPrice:FX_SL_NOT_BELOW_ENTRY"
      ]
    },
    {
      "name": "target equals entry",
      "entry": 100,
      "stopLoss": 85,
      "target": 100,
      "expect": [
        "targetSellPrice:FX_TARGET_NOT_ABOVE_ENTRY"
      ]
    },
    {
      "name": "target below stop-loss",
      "entry": 100,
      "stopLoss": 85,
      "target": 80,
      "expect": [
        "targetSellPrice:FX_TARGET_NOT_ABOVE_ENTRY"
      ]
    },
    {
      "name": "tick-sized bracket",
      "entry": 100.05,
      "stopLoss": 99.95,
      "target": 100.25,
      "expect": []
    }
  ],
