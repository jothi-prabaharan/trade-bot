# Temporary HTTP-only site used by install.sh to obtain the first Let's Encrypt certificate.
server {
    listen 80;
    @@LISTEN6_80@@
    server_name @@TRADEBOT_DOMAIN@@;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }
    location / {
        return 503 "TradeBot is being installed\n";
    }
}
