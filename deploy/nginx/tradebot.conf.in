# TradeBot dashboard + API (rendered by deploy.sh from deploy/nginx/tradebot.conf.in).
# Same origin: the Angular build is static, /api and /ws go to the API on 127.0.0.1:@@TRADEBOT_API_PORT@@.

limit_req_zone $binary_remote_addr zone=tradebot_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=tradebot_api:10m rate=20r/s;

map $http_upgrade $tradebot_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    @@LISTEN6_80@@
    server_name @@TRADEBOT_DOMAIN@@;

    # ACME HTTP-01 must stay reachable from Let's Encrypt (not allowlisted)
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # nginx 1.24 (Ubuntu 24.04) syntax; "http2 on;" needs 1.25.1+
    listen 443 ssl http2;
    @@LISTEN6_443@@
    server_name @@TRADEBOT_DOMAIN@@;

    ssl_certificate     /etc/letsencrypt/live/@@TRADEBOT_DOMAIN@@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@@TRADEBOT_DOMAIN@@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:tradebot_tls:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Only allowlisted networks reach anything below (tradebotctl allow-ip)
    include /etc/nginx/tradebot-allow.conf;
    limit_req_status 429;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' wss://@@TRADEBOT_DOMAIN@@; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;

    client_max_body_size 1m;
    gzip on;
    gzip_types text/css application/javascript application/json application/manifest+json image/svg+xml;

    root /opt/tradebot/current/web;
    index index.html;

    location = /api/auth/login {
        limit_req zone=tradebot_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:@@TRADEBOT_API_PORT@@;
        include /etc/nginx/tradebot-proxy.conf;
    }

    location ^~ /api/ {
        limit_req zone=tradebot_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:@@TRADEBOT_API_PORT@@;
        include /etc/nginx/tradebot-proxy.conf;
    }

    location = /health {
        proxy_pass http://127.0.0.1:@@TRADEBOT_API_PORT@@;
        include /etc/nginx/tradebot-proxy.conf;
    }

    location ^~ /ws/ {
        proxy_pass http://127.0.0.1:@@TRADEBOT_API_PORT@@;
        include /etc/nginx/tradebot-proxy.conf;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $tradebot_connection_upgrade;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        # The JWT travels in the query string here; keep it out of the access log
        access_log off;
    }

    # Content-hashed bundles (main-TA5HFSAB.js, chunk-…, styles-…) are immutable; quoted because of the {8}
    location ~ "-[A-Za-z0-9_-]{8}\.(?:js|css|woff2?|ttf|png|svg|jpe?g|gif|webp)$" {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # Unhashed files (icons, service worker, ngsw.json) revalidate every time, so a deploy reaches installed apps.
    # The service worker takes its CSP from this response.
    location ~* \.(?:js|css|woff2?|ico|png|svg|json)$ {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' wss://@@TRADEBOT_DOMAIN@@; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        try_files $uri =404;
    }

    # nginx 1.24 has no MIME type for .webmanifest
    location = /manifest.webmanifest {
        types { }
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    # index.html (SPA routes) never caches, so deploys take effect at once
    location / {
        add_header Cache-Control "no-cache" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' wss://@@TRADEBOT_DOMAIN@@; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
        try_files $uri $uri/ /index.html;
    }
}
