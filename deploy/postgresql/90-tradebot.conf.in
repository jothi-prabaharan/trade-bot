# TradeBot tuning for PostgreSQL 16 (rendered by install.sh for a @@TRADEBOT_MEMORY_GB@@ GB / @@TRADEBOT_CPU_CORES@@-core budget on SSD).
# For 16 GB / 4 cores: shared_buffers 4GB, effective_cache_size 10GB, work_mem 32MB, 4 parallel workers.

listen_addresses = 'localhost'
max_connections = 100                      # 3 services × pool 25 + backups/psql
password_encryption = scram-sha-256

shared_buffers = @@PG_SHARED_BUFFERS@@
effective_cache_size = @@PG_EFFECTIVE_CACHE@@
maintenance_work_mem = @@PG_MAINTENANCE_MEM@@
work_mem = @@PG_WORK_MEM@@
huge_pages = try
wal_buffers = 64MB

max_worker_processes = @@PG_MAX_WORKERS@@
max_parallel_workers = @@TRADEBOT_CPU_CORES@@
max_parallel_workers_per_gather = @@PG_PARALLEL_PER_GATHER@@
max_parallel_maintenance_workers = @@PG_PARALLEL_PER_GATHER@@

# SSD
random_page_cost = 1.1
effective_io_concurrency = 200

# WAL / checkpoints: smooth writes during the session
wal_compression = lz4
min_wal_size = 1GB
max_wal_size = 8GB
checkpoint_timeout = 15min
checkpoint_completion_target = 0.9

# Short OLTP queries: JIT costs more than it saves
jit = off
default_statistics_target = 200

# Candles and orders grow all day: vacuum/analyze early
autovacuum_max_workers = 3
autovacuum_naptime = 30s
autovacuum_vacuum_scale_factor = 0.05
autovacuum_analyze_scale_factor = 0.02

idle_in_transaction_session_timeout = 5min
track_io_timing = on

# Times are stored in UTC; logs read in IST
timezone = 'UTC'
log_timezone = 'Asia/Kolkata'
log_min_duration_statement = 500ms
log_checkpoints = on
log_lock_waits = on
log_temp_files = 10MB
log_autovacuum_min_duration = 1s
log_line_prefix = '%m [%p] %q%u@%d '
